<%- include('partials/_header') %>

<% if(mensagem) { %>
  <div class="mensagem-flash">✅ <%= mensagem %></div>
<% } %>

<%
  const toNum = v => parseFloat(String(v||'0').replace(/[^\d.,-]/g,'').replace(',','.')) || 0;
  const totalEstoque = dados.reduce((s,d) => s + toNum(d[9]), 0);
  const totalProdutos = dados.length;
  const totalCusto = dados.reduce((s,d) => s + (toNum(d[4]) * (toNum(d[8]) || 0)), 0);
  const abaixoMin = dados.filter(d => d[10] === 'Abaixo do mínimo').length;
%>

<div class="grid grid-4" style="margin-bottom: 24px;">
  <div class="kpi-card kpi-lucro">
    <div class="kpi-top"><span class="kpi-label">Valor Total em Estoque</span><div class="kpi-icon">💰</div></div>
    <div class="kpi-valor"><%= formatBRL(totalEstoque) %></div>
    <div class="kpi-sub">Baseado nos preços de venda</div>
  </div>
  <div class="card">
    <div class="card-header" style="border-bottom: none; padding-bottom: 0; margin-bottom: 0;">
      <h3 class="card-titulo">📦 SKUs Cadastrados</h3>
    </div>
    <div class="kpi-valor" style="color: var(--primario);"><%= totalProdutos %></div>
  </div>
  <div class="card">
    <div class="card-header" style="border-bottom: none; padding-bottom: 0; margin-bottom: 0;">
      <h3 class="card-titulo">📉 Custo Total</h3>
    </div>
    <div class="kpi-valor" style="color: #6A3EC4;"><%= formatBRL(totalCusto) %></div>
    <div class="kpi-sub">Margem bruta: <%= totalEstoque > 0 ? (((totalEstoque - totalCusto) / totalEstoque) * 100).toFixed(1) : 0 %>%</div>
  </div>
  <div class="card">
    <div class="card-header" style="border-bottom: none; padding-bottom: 0; margin-bottom: 0;">
      <h3 class="card-titulo">⚠️ Estoque Baixo</h3>
    </div>
    <div class="kpi-valor" style="color: <%= abaixoMin > 0 ? 'var(--erro)' : 'var(--sucesso)' %>;">
      <%= abaixoMin %>
    </div>
    <div class="kpi-sub">produtos abaixo do mínimo</div>
  </div>
</div>

<div class="grid grid-3" style="align-items: start; margin-bottom: 24px;">
  <div class="card" style="grid-column: span 1;">
    <div class="card-header"><h3 class="card-titulo">➕ Novo Produto</h3></div>
    <form action="/estoque/novo" method="POST">
      <div class="grid grid-2">
        <div class="form-group">
          <label class="form-label">ID Produto *</label>
          <input type="number" name="id" class="form-input" required value="<%= 10050 + dados.length %>">
        </div>
        <div class="form-group">
          <label class="form-label">Categoria</label>
          <select name="categoria" class="form-select">
            <option>Eletrônicos</option>
            <option>Acessórios</option>
            <option>Hardware</option>
            <option>Software</option>
            <option>Móveis</option>
            <option>Outros</option>
          </select>
        </div>
      </div>
      <div class="form-group">
        <label class="form-label">Nome do Produto *</label>
        <input type="text" name="produto" class="form-input" required>
      </div>
      <div class="form-group">
        <label class="form-label">Fornecedor</label>
        <input type="text" name="fornecedor" class="form-input">
      </div>
      <div class="grid grid-2">
        <div class="form-group">
          <label class="form-label">Preço Custo (R$) *</label>
          <input type="number" name="custo" step="0.01" min="0" class="form-input" required>
        </div>
        <div class="form-group">
          <label class="form-label">Preço Venda (R$) *</label>
          <input type="number" name="venda" step="0.01" min="0" class="form-input" required>
        </div>
      </div>
      <div class="grid grid-2">
        <div class="form-group">
          <label class="form-label">Qtd. Mínima</label>
          <input type="number" name="qtd_min" min="0" class="form-input" value="3">
        </div>
        <div class="form-group">
          <label class="form-label">Qtd. Atual</label>
          <input type="number" name="qtd_atual" min="0" class="form-input" value="10">
        </div>
      </div>
      <button type="submit" class="btn btn-primary btn-block">💾 Cadastrar Produto</button>
    </form>
  </div>

  <div class="card" style="grid-column: span 2;">
    <div class="card-header">
      <h3 class="card-titulo">📋 Controle de Estoque</h3>
      <span class="tag tag-info"><%= totalProdutos %> produtos</span>
    </div>
    <div class="table-wrapper">
      <table class="tabela">
        <thead>
          <tr>
            <th>ID</th>
            <th>Produto</th>
            <th>Categoria</th>
            <th class="numero">Custo</th>
            <th class="numero">Venda</th>
            <th class="numero">Margem</th>
            <th class="numero">Qtd Atual</th>
            <th class="texto-centro">Status</th>
          </tr>
        </thead>
        <tbody>
          <% dados.forEach(d => {
            const status = d[10] === 'Abaixo do mínimo' ? 'abaixo' : 'normal';
          %>
            <tr>
              <td><b>#<%= d[0] %></b></td>
              <td>
                <b><%= d[1] %></b><br>
                <small style="color: var(--texto-claro);"><%= d[3] || '—' %></small>
              </td>
              <td><span class="badge badge-eletronicos"><%= d[2] %></span></td>
              <td class="numero" style="color: #6A3EC4;">
                <%= typeof d[4] === 'number' ? formatBRL(d[4]) : d[4] %>
              </td>
              <td class="numero" style="color: var(--sucesso); font-weight: 700;">
                <%= typeof d[5] === 'number' ? formatBRL(d[5]) : d[5] %>
              </td>
              <td class="numero">
                <% const margem = toNum(d[6]); %>
                <span class="tag <%= margem >= 0.3 ? 'tag-positivo' : margem >= 0.15 ? 'tag-aviso' : 'tag-negativo' %>">
                  <%= (margem * 100).toFixed(0).replace('.', ',') %>%
                </span>
              </td>
              <td class="numero">
                <b style="<%= status === 'abaixo' ? 'color: var(--erro)' : '' %>"><%= d[8] %></b>
                <small style="color: var(--texto-claro);">/<%= d[7] %></small>
              </td>
              <td class="texto-centro">
                <span class="badge badge-<%= status %>">
                  <%= status === 'abaixo' ? '⚠️ Abaixo' : '✅ Normal' %>
                </span>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%- include('partials/_footer') %>
