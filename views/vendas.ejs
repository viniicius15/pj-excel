<%- include('partials/_header') %>

<% if(mensagem) { %>
  <div class="mensagem-flash">✅ <%= mensagem %></div>
<% } %>

<%
  const toNum = v => parseFloat(String(v||'0').replace(/[^\d.,-]/g,'').replace(',','.')) || 0;
  const totalVendas = dados.reduce((s,d) => s + toNum(d[11]), 0);
  const aprovadas = dados.filter(d => d[12] === 'Aprovado').reduce((s,d) => s + toNum(d[11]), 0);
  const ticket = dados.length ? (totalVendas / dados.length) : 0;
%>

<div class="grid grid-4" style="margin-bottom: 24px;">
  <div class="kpi-card kpi-vendas">
    <div class="kpi-top"><span class="kpi-label">Total de Vendas</span><div class="kpi-icon">💰</div></div>
    <div class="kpi-valor"><%= formatBRL(totalVendas) %></div>
    <div class="kpi-sub"><%= dados.length %> pedidos registrados</div>
  </div>
  <div class="card">
    <div class="card-header" style="border-bottom: none; padding-bottom: 0; margin-bottom: 0;">
      <h3 class="card-titulo">✅ Aprovadas</h3>
    </div>
    <div class="kpi-valor" style="color: var(--sucesso);"><%= formatBRL(aprovadas) %></div>
  </div>
  <div class="card">
    <div class="card-header" style="border-bottom: none; padding-bottom: 0; margin-bottom: 0;">
      <h3 class="card-titulo">⏳ Pendentes</h3>
    </div>
    <div class="kpi-valor" style="color: var(--aviso);"><%= formatBRL(totalVendas - aprovadas) %></div>
  </div>
  <div class="card">
    <div class="card-header" style="border-bottom: none; padding-bottom: 0; margin-bottom: 0;">
      <h3 class="card-titulo">🎟️ Ticket Médio</h3>
    </div>
    <div class="kpi-valor" style="color: var(--primario);"><%= formatBRL(ticket) %></div>
  </div>
</div>

<div class="grid grid-3" style="align-items: start;">
  <div class="card" style="grid-column: span 1;">
    <div class="card-header">
      <h3 class="card-titulo">➕ Nova Venda</h3>
    </div>
    <form action="/vendas/novo" method="POST" id="form-venda">
      <div class="grid grid-2">
        <div class="form-group">
          <label class="form-label">Nº Venda *</label>
          <input type="number" name="numero" class="form-input" required value="<%= 1050 + dados.length %>">
        </div>
        <div class="form-group">
          <label class="form-label">Data *</label>
          <input type="text" name="data" class="form-input" required
                 value="<%= new Date().toLocaleDateString('pt-BR') %>">
        </div>
      </div>
      <div class="form-group">
        <label class="form-label">Vendedor *</label>
        <select name="vendedor" class="form-select" required>
          <option>João Paulo Ferreira</option>
          <option>Mariana Silva Santos</option>
          <option>Ana Beatriz Costa</option>
          <option>Pedro Lucas Almeida</option>
          <option>Carlos Henrique Novaes</option>
        </select>
      </div>
      <div class="form-group">
        <label class="form-label">Cliente *</label>
        <input type="text" name="cliente" class="form-input" required>
      </div>
      <div class="grid grid-2">
        <div class="form-group">
          <label class="form-label">Produto *</label>
          <input type="text" name="produto" class="form-input" required>
        </div>
        <div class="form-group">
          <label class="form-label">Categoria</label>
          <select name="categoria" class="form-select">
            <option>Eletrônicos</option>
            <option>Software</option>
            <option>Hardware</option>
            <option>Serviços</option>
            <option>Acessórios</option>
            <option>Móveis</option>
          </select>
        </div>
      </div>
      <div class="grid grid-3">
        <div class="form-group">
          <label class="form-label">Quantidade *</label>
          <input type="number" name="quantidade" id="qtd" class="form-input" min="1" value="1" required>
        </div>
        <div class="form-group">
          <label class="form-label">Preço Unit. *</label>
          <input type="number" name="preco" id="preco" class="form-input" step="0.01" min="0" value="0" required>
        </div>
        <div class="form-group">
          <label class="form-label">Desconto (%)</label>
          <input type="number" name="desconto" id="desconto" class="form-input" min="0" max="100" value="0">
        </div>
      </div>
      <div class="grid grid-2">
        <div class="form-group">
          <label class="form-label">Status</label>
          <select name="status" class="form-select">
            <option>Aprovado</option>
            <option>Pendente</option>
            <option>Cancelado</option>
          </select>
        </div>
        <div class="form-group">
          <label class="form-label">Pagamento</label>
          <select name="pagamento" class="form-select">
            <option>PIX</option>
            <option>Boleto</option>
            <option>Transferência</option>
            <option>Cartão Crédito</option>
            <option>Cartão Débito</option>
            <option>Dinheiro</option>
          </select>
        </div>
      </div>
      <div id="preview-total" style="margin-bottom: 18px; padding: 14px; border-radius: 12px; background: var(--sucesso-claro); border: 1px solid #A7E8C7;">
        <small style="color: var(--sucesso); font-weight: 600;">TOTAL ESTIMADO</small>
        <div style="font-size: 22px; font-weight: 800; color: var(--sucesso); margin-top: 4px;" id="preview-valor">R$ 0,00</div>
      </div>
      <button type="submit" class="btn btn-success btn-block">💾 Registrar Venda</button>
    </form>
  </div>

  <div class="card" style="grid-column: span 2;">
    <div class="card-header">
      <h3 class="card-titulo">📋 Histórico de Vendas</h3>
      <span class="tag tag-info"><%= dados.length %> vendas</span>
    </div>
    <div class="table-wrapper">
      <table class="tabela">
        <thead>
          <tr>
            <th>Nº</th>
            <th>Data</th>
            <th>Cliente / Vendedor</th>
            <th>Produto</th>
            <th class="numero">Qtd</th>
            <th class="numero">Total</th>
            <th class="texto-centro">Status</th>
          </tr>
        </thead>
        <tbody>
          <% dados.slice().reverse().forEach(d => { %>
            <tr>
              <td><b>#<%= d[0] %></b></td>
              <td><%= d[1] %></td>
              <td>
                <b><%= d[3] %></b><br>
                <small style="color: var(--texto-claro);"><%= (d[2]||'').split(' ')[0] %></small>
              </td>
              <td>
                <%= d[4] %><br>
                <small class="badge badge-<%= String(d[5]||'').toLowerCase().replace(/[çãáâêóõúí]/g, c => ({ç:'c',ã:'a',á:'a',â:'a',ê:'e',ó:'o',õ:'o',ú:'u',í:'i'}[c] || c)) %>" style="margin-top: 3px;"><%= d[5] %></small>
              </td>
              <td class="numero"><%= d[6] %></td>
              <td class="numero" style="color: var(--sucesso); font-weight: 700;">
                <%= typeof d[11] === 'number' ? formatBRL(d[11]) : d[11] %>
              </td>
              <td class="texto-centro">
                <span class="badge badge-<%= (d[12]||'pendente').toLowerCase() %>"><%= d[12] %></span>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<script>
  function calcularTotal() {
    const qtd = parseFloat(document.getElementById('qtd').value) || 0;
    const prec = parseFloat(document.getElementById('preco').value) || 0;
    const desc = parseFloat(document.getElementById('desconto').value) || 0;
    const subtotal = qtd * prec;
    const total = subtotal * (1 - (desc / 100));
    document.getElementById('preview-valor').textContent =
      'R$ ' + total.toLocaleString('pt-BR', {minimumFractionDigits: 2});
  }
  ['qtd','preco','desconto'].forEach(id => {
    document.getElementById(id).addEventListener('input', calcularTotal);
  });
  calcularTotal();
</script>

<%- include('partials/_footer') %>
